// Structural recursion on Nat. `add` decreases in its first argument.
fn add(a: Nat, b: Nat): Nat {
  match a {
    Zero => b
    Succ(p) => Succ(add(p, b))
  }
}

fn mul(a: Nat, b: Nat): Nat {
  match a {
    Zero => Zero
    Succ(p) => add(b, mul(p, b))
  }
}

fn main(): IO[Nat] {
  IO::pure(mul(6, 7))
}
