// Indexed families use explicit constructor result types. Named fields act
// as binders for later fields and for the result type.
//
// Note: `neo` can build this program because `main` returns `Nat`. A program
// whose `main` returns `Vec(T, n)` can be interpreted, but the WASM backend
// cannot print fields whose types depend on earlier fields yet.
enum Vec(T: Type, n: Nat) {
  vnil : Vec(T, zero)
  vcons(m: Nat, x: T, xs: Vec(T, m)) : Vec(T, succ(m))
}

fn add(a: Nat, b: Nat): Nat {
  match a {
    zero => b
    succ(k) => succ(add(k, b))
  }
}

// Matching refines the context index: `n` is `zero` in the first branch and
// `succ(m)` in the second, which is what makes the recursive call well typed.
fn length(n: Nat, v: Vec(Nat, n)): Nat {
  match v {
    vnil => zero
    vcons(m, x, xs) => succ(length(m, xs))
  }
}

fn append(n: Nat, m: Nat, xs: Vec(Nat, n), ys: Vec(Nat, m)): Vec(Nat, add(n, m)) {
  match xs {
    vnil => ys
    vcons(k, x, tail) => vcons(add(k, m), x, append(k, m, tail, ys))
  }
}

fn two(): Vec(Nat, 2) {
  vcons(1, 4, vcons(0, 3, vnil))
}

fn three(): Vec(Nat, 3) {
  append(2, 1, two(), vcons(0, 7, vnil))
}

fn main(): Nat {
  // Try `two()` or `three()` in the REPL to see the vectors.
  length(3, three())
}
