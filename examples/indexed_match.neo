// Branch-field index refinement.
//
// When the scrutinee index is constructor-headed, the checker can rule out
// impossible constructors and refine branch fields. Here `vnil` is impossible
// for `Vec(Nat, succ(n))`, so the `vnil` arm can be omitted. In the `vcons`
// arm, `succ(m) == succ(n)` refines `m` to `n`, making the tail have type
// `Vec(Nat, n)`.
enum Vec(T: Type, n: Nat) {
  vnil : Vec(T, zero)
  vcons(m: Nat, x: T, xs: Vec(T, m)) : Vec(T, succ(m))
}

fn head(n: Nat, v: Vec(Nat, succ(n))): Nat {
  match v {
    vcons(m, x, xs) => x
  }
}

fn tail(n: Nat, v: Vec(Nat, succ(n))): Vec(Nat, n) {
  match v {
    vcons(m, x, xs) => xs
  }
}

fn main(): Nat {
  head(1, vcons(1, 4, vcons(0, 3, vnil)))
}
