// Methods are functions namespaced by their receiver type. Different types may
// declare the same method name; dispatch uses the receiver's type.
impl Bool {
  pub fn not(self: Bool): Bool {
    match self {
      False => True
      True => False
    }
  }
}

enum Shape {
  circle(U32)
  rect(U32, U32)
}

impl Shape {
  pub fn area(self: Shape): U32 {
    match self {
      circle(r) => r * r * 3u32
      rect(w, h) => w * h
    }
  }
}

fn main(): IO[U32] {
  match Bool::False.not() {
    True => IO::pure(rect(3u32, 4u32).area())
    False => IO::pure(0u32)
  }
}
