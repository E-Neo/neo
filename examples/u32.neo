// `U32` is a primitive machine word. Its operations are total: arithmetic
// wraps, division by zero yields zero, and comparisons return `Bool`.
fn is_even(n: U32): Bool {
  u32_eq(u32_rem(n, 2u32), 0u32)
}

fn main(): U32 {
  match is_even(4u32) {
    true => u32_add(u32_mul(6u32, 7u32), u32_div(1u32, 0u32))
    false => u32_sub(0u32, 1u32)
  }
}
