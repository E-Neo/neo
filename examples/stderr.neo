// `extern` declares a host capability inside a module. The compiler lowers
// `log::write` to `wasi:cli/stderr@0.2.9#get-stderr` plus
// `output-stream.blocking-write-and-flush`.
mod log {
  pub extern fn write(s: String): IO[Result[Unit, IoError]] = "wasi:cli/stderr@0.2.9#write"
}

fn exit_code(r: Result[Unit, IoError]): IO[U32] {
  match r {
    Ok(_) => IO::pure(0u32)
    Err(_) => IO::pure(1u32)
  }
}

fn main(): IO[U32] {
  IO::bind(log::write("hello from stderr\n"), exit_code)
}
