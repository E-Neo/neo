// Context index refinement in `append`.
//
// Matching `xs : Vec(Nat, n)` against `vcons(k, x, tail)` solves the context
// index `n := succ(k)`. The branch may therefore build a vector of index
// `add(succ(k), m)`, which converts to `succ(add(k, m))` by unfolding `add`.
enum Vec(T: Type, n: Nat) {
  vnil : Vec(T, zero)
  vcons(m: Nat, x: T, xs: Vec(T, m)) : Vec(T, succ(m))
}

fn add(a: Nat, b: Nat): Nat {
  match a {
    zero => b
    succ(k) => succ(add(k, b))
  }
}

fn length(n: Nat, v: Vec(Nat, n)): Nat {
  match v {
    vnil => zero
    vcons(m, x, xs) => succ(length(m, xs))
  }
}

fn append(n: Nat, m: Nat, xs: Vec(Nat, n), ys: Vec(Nat, m)): Vec(Nat, add(n, m)) {
  match xs {
    vnil => ys
    vcons(k, x, tail) => vcons(add(k, m), x, append(k, m, tail, ys))
  }
}

fn main(): Nat {
  length(3, append(2, 1, vcons(1, 10, vcons(0, 20, vnil)), vcons(0, 30, vnil)))
}
