// Context index refinement in `append`.
//
// Matching `xs : Vec[T, n]` against `vcons(k, x, tail)` solves the context
// index `n := succ(k)`. The branch may therefore build a vector of index
// `add(succ(k), m)`, which converts to `succ(add(k, m))` by unfolding `add`.
enum Vec[T: Type, n: Nat] {
  vnil : Vec[T, zero]
  vcons(m: Nat, x: T, xs: Vec[T, m]) : Vec[T, succ(m)]
}

fn add(a: Nat, b: Nat): Nat {
  match a {
    zero => b
    succ(k) => succ(add(k, b))
  }
}

fn length[T: Type, n: Nat](v: Vec[T, n]): Nat {
  match v {
    vnil => zero
    vcons(m, x, xs) => succ(length(xs))
  }
}

fn append[T: Type, n: Nat, m: Nat](
  xs: Vec[T, n],
  ys: Vec[T, m]
): Vec[T, add(n, m)] {
  match xs {
    vnil => ys
    vcons(k, x, tail) => vcons(add(k, m), x, append(tail, ys))
  }
}

fn main(): Nat {
  length(append(vcons(1, (10 : Nat), vcons(0, (20 : Nat), vnil)), vcons(0, (30 : Nat), vnil)))
}
