// Types are first-class: `mul` is defined after the `add` it calls.
fn add(a: Nat, b: Nat): Nat {
  match a {
    Zero => b
    Succ(p) => Succ(add(p, b))
  }
}

fn mul(a: Nat, b: Nat): Nat {
  match a {
    Zero => Zero
    Succ(p) => add(b, mul(p, b))
  }
}

enum Shape {
  circle(Nat)
  rect(Nat, Nat)
}

fn area(s: Shape): Nat {
  match s {
    circle(r) => mul(r, r)
    rect(w, h) => mul(w, h)
  }
}

fn main(): IO[Nat] {
  IO::pure(area(rect(3, 4)))
}
