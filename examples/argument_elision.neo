// Implicit parameters are inferred when a call omits them.
//
// Parameters in `[]` are implicit. At a call site the elaborator fills them
// from the types of the explicit arguments and from the expected type. The
// explicit form `append[Nat, 1, 2](v1(), v2())` is also accepted.
enum Vec[T: Type, n: Nat] {
  Vnil : Vec[T, Zero]
  Vcons(m: Nat, x: T, xs: Vec[T, m]) : Vec[T, Succ(m)]
}

fn add(a: Nat, b: Nat): Nat {
  match a {
    Zero => b
    Succ(k) => Succ(add(k, b))
  }
}

fn length[T: Type, n: Nat](v: Vec[T, n]): Nat {
  match v {
    Vnil => Zero
    Vcons(m, x, xs) => Succ(length(xs))
  }
}

fn append[T: Type, n: Nat, m: Nat](
  xs: Vec[T, n],
  ys: Vec[T, m]
): Vec[T, add(n, m)] {
  match xs {
    Vnil => ys
    Vcons(k, x, tail) => Vcons(add(k, m), x, append(tail, ys))
  }
}

fn v1(): Vec[Nat, 1] {
  Vcons(0, 10, Vnil)
}

fn v2(): Vec[Nat, 2] {
  Vcons(1, 20, Vcons(0, 30, Vnil))
}

fn main(): IO[Nat] {
  // Both recursive calls omit their implicit arguments. The explicit form
  // `append[Nat, 1, 2](v1(), v2())` is still accepted.
  IO::pure(length(append(v1(), v2())))
}
