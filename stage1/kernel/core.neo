pub enum PositivityError {
  Negative
  Nested
  Unknown
}

pub fn contains_enum(name: String, tm: Tm): Bool {
  match tm {
    Var(_) => False
    Const(_) => False
    Ty(_) => False
    PropTy => False
    TNil => False
    TBrNil => False
    TCons(head, tail) => match contains_enum(name, head) {
      True => True
      False => contains_enum(name, tail)
    }
    Ind(enum_name, args) => match enum_name == name {
      True => True
      False => contains_enum(name, args)
    }
    Ctor(_, _, args) => contains_enum(name, args)
    Pi(_, dom, cod) => match contains_enum(name, dom) {
      True => True
      False => contains_enum(name, cod)
    }
    Lam(_, dom, body) => match contains_enum(name, dom) {
      True => True
      False => contains_enum(name, body)
    }
    App(f, a) => match contains_enum(name, f) {
      True => True
      False => contains_enum(name, a)
    }
    Match(scrut, branches) => match contains_enum(name, scrut) {
      True => True
      False => contains_enum(name, branches)
    }
    TBrCons(_, _, body, rest) => match contains_enum(name, body) {
      True => True
      False => contains_enum(name, rest)
    }
    Eq(lhs, rhs) => match contains_enum(name, lhs) {
      True => True
      False => contains_enum(name, rhs)
    }
    ReflTm(value) => contains_enum(name, value)
    J(a, b, c, d, e, f) => match contains_enum(name, a) {
      True => True
      False => match contains_enum(name, b) {
        True => True
        False => match contains_enum(name, c) {
          True => True
          False => match contains_enum(name, d) {
            True => True
            False => match contains_enum(name, e) {
              True => True
              False => contains_enum(name, f)
            }
          }
        }
      }
    }
  }
}

fn check_field_domain(name: String, dom: Tm): Result[Unit, PositivityError] {
  match dom {
    Ind(enum_name, args) => match enum_name == name {
      True => match contains_enum(name, args) {
        True => Err(Nested)
        False => Ok(Unit)
      }
      False => match contains_enum(name, dom) {
        True => Err(Nested)
        False => Ok(Unit)
      }
    }
    Pi(_, _, _) => match contains_enum(name, dom) {
      True => Err(Negative)
      False => Ok(Unit)
    }
    Var(_) => Ok(Unit)
    Const(_) => Ok(Unit)
    Ty(_) => Ok(Unit)
    PropTy => Ok(Unit)
    TNil => Ok(Unit)
    TCons(_, _) => match contains_enum(name, dom) {
      True => Err(Nested)
      False => Ok(Unit)
    }
    Ctor(_, _, _) => match contains_enum(name, dom) {
      True => Err(Nested)
      False => Ok(Unit)
    }
    Lam(_, _, _) => match contains_enum(name, dom) {
      True => Err(Negative)
      False => Ok(Unit)
    }
    App(_, _) => match contains_enum(name, dom) {
      True => Err(Nested)
      False => Ok(Unit)
    }
    Match(_, _) => match contains_enum(name, dom) {
      True => Err(Nested)
      False => Ok(Unit)
    }
    TBrNil => Ok(Unit)
    TBrCons(_, _, _, _) => match contains_enum(name, dom) {
      True => Err(Nested)
      False => Ok(Unit)
    }
    Eq(_, _) => match contains_enum(name, dom) {
      True => Err(Nested)
      False => Ok(Unit)
    }
    ReflTm(_) => match contains_enum(name, dom) {
      True => Err(Nested)
      False => Ok(Unit)
    }
    J(_, _, _, _, _, _) => match contains_enum(name, dom) {
      True => Err(Nested)
      False => Ok(Unit)
    }
  }
}

fn check_ctor_positivity(name: String, ty: Tm): Result[Unit, PositivityError] {
  match ty {
    Pi(_, dom, cod) => match check_field_domain(name, dom) {
      Ok(Unit) => check_ctor_positivity(name, cod)
      Err(e) => Err(e)
    }
    Var(_) => Ok(Unit)
    Const(_) => Ok(Unit)
    Ty(_) => Ok(Unit)
    PropTy => Ok(Unit)
    TNil => Ok(Unit)
    TCons(_, _) => Ok(Unit)
    Ind(_, _) => Ok(Unit)
    Ctor(_, _, _) => Ok(Unit)
    Lam(_, _, _) => Ok(Unit)
    App(_, _) => Ok(Unit)
    Match(_, _) => Ok(Unit)
    TBrNil => Ok(Unit)
    TBrCons(_, _, _, _) => Ok(Unit)
    Eq(_, _) => Ok(Unit)
    ReflTm(_) => Ok(Unit)
    J(_, _, _, _, _, _) => Ok(Unit)
  }
}

fn check_ctors_positivity(name: String, ctors: CtorList): Result[Unit, PositivityError] {
  match ctors {
    CNil => Ok(Unit)
    CCons(CtorData(_, _, _, _, _, ty), rest) => match check_ctor_positivity(name, ty) {
      Ok(Unit) => check_ctors_positivity(name, rest)
      Err(e) => Err(e)
    }
  }
}

pub fn check_positivity(
  globals: fn(String) -> Option[EnumInfo],
  name: String
): Result[Unit, PositivityError] {
  match globals(name) {
    Some(EnumData(_, _, _, _, ctors)) => check_ctors_positivity(name, ctors)
    None => Err(Unknown)
  }
}

fn negative_globals(name: String): Option[EnumInfo] {
  match name == "Bad" {
    True => Some(
      EnumData(
        "Bad",
        0u32,
        SType(0u32),
        False,
        CCons(
          CtorData(
            "Mk",
            "Bad",
            0u32,
            0u32,
            1u32,
            Pi("f", Pi("x", Ind("Bad", TNil), Ind("Bad", TNil)), Ind("Bad", TNil))
          ),
          CNil
        )
      )
    )
    False => None
  }
}

fn nested_globals(name: String): Option[EnumInfo] {
  match name == "Bad" {
    True => Some(
      EnumData(
        "Bad",
        0u32,
        SType(0u32),
        False,
        CCons(
          CtorData(
            "Mk",
            "Bad",
            0u32,
            0u32,
            1u32,
            Pi(
              "f",
              Ind("List", TCons(Ind("Bad", TNil), TNil)),
              Ind("Bad", TNil)
            )
          ),
          CNil
        )
      )
    )
    False => None
  }
}

pub fn demo_positive_bool(): U32 {
  match check_positivity(bool_globals, "Bool") {
    Ok(Unit) => 1u32
    Err(_) => 0u32
  }
}

pub fn demo_negative_positivity(): U32 {
  match check_positivity(negative_globals, "Bad") {
    Err(Negative) => 1u32
    Err(_) => 0u32
    Ok(Unit) => 0u32
  }
}

pub fn demo_nested_positivity(): U32 {
  match check_positivity(nested_globals, "Bad") {
    Err(Nested) => 1u32
    Err(_) => 0u32
    Ok(Unit) => 0u32
  }
}

pub fn u32_digits(fuel: Nat, n: U32, acc: Bytes): Bytes {
  match fuel {
    Zero => acc
    Succ(k) => match n < 10u32 {
      True => (n + 48u32).to_byte().concat(acc)
      False => u32_digits(k, n / 10u32, (n % 10u32 + 48u32).to_byte().concat(acc))
    }
  }
}

pub fn show_u32(fuel: Nat, n: U32): String {
  match u32_digits(fuel, n, b"").to_str() {
    Ok(text) => text
    Err(_) => "?"
  }
}

pub fn list_at(names: List[String], index: U32): String {
  match names {
    Nil => "#"
    Cons(name, rest) => match index == 0u32 {
      True => name
      False => list_at(rest, index - 1u32)
    }
  }
}

pub fn show_tm(fuel: Nat, names: List[String], tm: Tm): String {
  match fuel {
    Zero => "?"
    Succ(k) => match tm {
      Var(index) => list_at(names, index)
      Const(name) => name
      Ty(level) => "Type ".concat(show_u32(k, level))
      PropTy => "Prop"
      TNil => "[]"
      TCons(_, _) => "[...]"
      Ind(name, _) => name
      Ctor(name, _, _) => name
      Pi(name, dom, cod) => "fn(".concat(name).concat(": ").concat(show_tm(k, names, dom)).concat(") -> ").concat(show_tm(k, Cons(name, names), cod))
      Lam(name, dom, body) => "fn(".concat(name).concat(": ").concat(show_tm(k, names, dom)).concat(") => ").concat(show_tm(k, Cons(name, names), body))
      App(f, a) => show_tm(k, names, f).concat("(").concat(show_tm(k, names, a)).concat(")")
      Match(_, _) => "match(...)"
      TBrNil => "branch[]"
      TBrCons(_, _, _, _) => "branch"
      Eq(lhs, rhs) => show_tm(k, names, lhs).concat(" = ").concat(show_tm(k, names, rhs))
      ReflTm(value) => "Refl(".concat(show_tm(k, names, value)).concat(")")
      J(_, _, _, _, _, _) => "J(...)"
    }
  }
}

pub fn demo_show_type(): U32 {
  match show_tm(100, Nil, Ty(0u32)) == "Type 0" {
    True => 1u32
    False => 0u32
  }
}

pub fn demo_show_lambda(): U32 {
  match show_tm(100, Nil, Lam("x", Ty(0u32), Var(0u32))) == "fn(x: Type 0) => x" {
    True => 1u32
    False => 0u32
  }
}

pub fn demo_show_pi(): U32 {
  match show_tm(100, Nil, Pi("x", Ty(0u32), Ty(0u32))) == "fn(x: Type 0) -> Type 0" {
    True => 1u32
    False => 0u32
  }
}

pub fn demo_show_app(): U32 {
  match normalize(100, App(Lam("x", Ty(0u32), Var(0u32)), Ty(0u32))) {
    Ok(value) => match show_tm(100, Nil, value) == "Type 0" {
      True => 1u32
      False => 0u32
    }
    Err(_) => 0u32
  }
}

pub enum TerminationError {
  NotDecreasing
  TooDeep
}

pub enum FnInfo {
  FnData(String, U32, Tm)
}

pub enum FnList {
  FnNil
  FnCons(FnInfo, FnList)
}

fn shift_decreasing(xs: List[U32], by: U32): List[U32] {
  match xs {
    Nil => Nil
    Cons(x, rest) => Cons(x + by, shift_decreasing(rest, by))
  }
}

fn add_fields(fuel: Nat, n: U32, acc: List[U32]): List[U32] {
  match fuel {
    Zero => acc
    Succ(k) => match n == 0u32 {
      True => acc
      False => add_fields(k, n - 1u32, Cons(n - 1u32, acc))
    }
  }
}

fn member(xs: List[U32], value: U32): Bool {
  match xs {
    Nil => False
    Cons(x, rest) => match x == value {
      True => True
      False => member(rest, value)
    }
  }
}

fn contains_decreasing(tm: Tm, decreasing: List[U32]): Bool {
  match tm {
    Var(index) => member(decreasing, index)
    TCons(head, tail) => match contains_decreasing(head, decreasing) {
      True => True
      False => contains_decreasing(tail, decreasing)
    }
    Ind(_, args) => contains_decreasing(args, decreasing)
    Ctor(_, _, args) => contains_decreasing(args, decreasing)
    Const(_) => False
    Ty(_) => False
    PropTy => False
    TNil => False
    Pi(_, _, _) => False
    Lam(_, _, _) => False
    App(_, _) => False
    Match(_, _) => False
    TBrNil => False
    TBrCons(_, _, _, _) => False
    Eq(_, _) => False
    ReflTm(_) => False
    J(_, _, _, _, _, _) => False
  }
}

fn has_decreasing_arg(args: Tm, decreasing: List[U32]): Bool {
  match args {
    TNil => False
    TCons(head, tail) => match contains_decreasing(head, decreasing) {
      True => True
      False => has_decreasing_arg(tail, decreasing)
    }
    Var(_) => False
    Const(_) => False
    Ty(_) => False
    PropTy => False
    Ind(_, _) => False
    Ctor(_, _, _) => False
    Pi(_, _, _) => False
    Lam(_, _, _) => False
    App(_, _) => False
    Match(_, _) => False
    TBrNil => False
    TBrCons(_, _, _, _) => False
    Eq(_, _) => False
    ReflTm(_) => False
    J(_, _, _, _, _, _) => False
  }
}

fn call_spine(name: String, tm: Tm, acc: Tm): Option[Tm] {
  match tm {
    App(f, a) => call_spine(name, f, TCons(a, acc))
    Const(fname) => match fname == name {
      True => Some(acc)
      False => None
    }
    Var(_) => None
    Ty(_) => None
    PropTy => None
    TNil => None
    TCons(_, _) => None
    Ind(_, _) => None
    Ctor(_, _, _) => None
    Pi(_, _, _) => None
    Lam(_, _, _) => None
    Match(_, _) => None
    TBrNil => None
    TBrCons(_, _, _, _) => None
    Eq(_, _) => None
    ReflTm(_) => None
    J(_, _, _, _, _, _) => None
  }
}

fn check_args(
  fuel: Nat,
  name: String,
  depth: U32,
  decreasing: List[U32],
  args: Tm
): Result[Unit, TerminationError] {
  match fuel {
    Zero => Err(TerminationError::TooDeep)
    Succ(k) => match args {
      TNil => Ok(Unit)
      TCons(head, tail) => match check_tm(k, name, depth, decreasing, head) {
        Ok(Unit) => check_args(k, name, depth, decreasing, tail)
        Err(e) => Err(e)
      }
      Var(_) => Ok(Unit)
      Const(_) => Ok(Unit)
      Ty(_) => Ok(Unit)
      PropTy => Ok(Unit)
      Ind(_, _) => Ok(Unit)
      Ctor(_, _, _) => Ok(Unit)
      Pi(_, _, _) => Ok(Unit)
      Lam(_, _, _) => Ok(Unit)
      App(_, _) => Ok(Unit)
      Match(_, _) => Ok(Unit)
      TBrNil => Ok(Unit)
      TBrCons(_, _, _, _) => Ok(Unit)
      Eq(_, _) => Ok(Unit)
      ReflTm(_) => Ok(Unit)
      J(_, _, _, _, _, _) => Ok(Unit)
    }
  }
}

fn check_branches(
  fuel: Nat,
  name: String,
  depth: U32,
  decreasing: List[U32],
  branches: Tm
): Result[Unit, TerminationError] {
  match fuel {
    Zero => Err(TerminationError::TooDeep)
    Succ(k) => match branches {
      TBrNil => Ok(Unit)
      TBrCons(_, binders, body, rest) => {
        let shifted = shift_decreasing(decreasing, binders)
        let inner = add_fields(16, binders, shifted)
        match check_tm(k, name, depth + binders, inner, body) {
          Ok(Unit) => check_branches(k, name, depth, decreasing, rest)
          Err(e) => Err(e)
        }
      }
      TNil => Ok(Unit)
      TCons(_, _) => Ok(Unit)
      Var(_) => Ok(Unit)
      Const(_) => Ok(Unit)
      Ty(_) => Ok(Unit)
      PropTy => Ok(Unit)
      Ind(_, _) => Ok(Unit)
      Ctor(_, _, _) => Ok(Unit)
      Pi(_, _, _) => Ok(Unit)
      Lam(_, _, _) => Ok(Unit)
      App(_, _) => Ok(Unit)
      Match(_, _) => Ok(Unit)
      Eq(_, _) => Ok(Unit)
      ReflTm(_) => Ok(Unit)
      J(_, _, _, _, _, _) => Ok(Unit)
    }
  }
}

fn check_tm(
  fuel: Nat,
  name: String,
  depth: U32,
  decreasing: List[U32],
  tm: Tm
): Result[Unit, TerminationError] {
  match fuel {
    Zero => Err(TerminationError::TooDeep)
    Succ(k) => match tm {
      App(_, _) => match call_spine(name, tm, TNil) {
        Some(args) => match has_decreasing_arg(args, decreasing) {
          True => check_args(k, name, depth, decreasing, args)
          False => Err(NotDecreasing)
        }
        None => match tm {
          App(f, a) => match check_tm(k, name, depth, decreasing, f) {
            Ok(Unit) => check_tm(k, name, depth, decreasing, a)
            Err(e) => Err(e)
          }
          Const(_) => Ok(Unit)
          Var(_) => Ok(Unit)
          Ty(_) => Ok(Unit)
          PropTy => Ok(Unit)
          TNil => Ok(Unit)
          TCons(_, _) => Ok(Unit)
          Ind(_, _) => Ok(Unit)
          Ctor(_, _, _) => Ok(Unit)
          Pi(_, _, _) => Ok(Unit)
          Lam(_, _, _) => Ok(Unit)
          Match(_, _) => Ok(Unit)
          TBrNil => Ok(Unit)
          TBrCons(_, _, _, _) => Ok(Unit)
          Eq(_, _) => Ok(Unit)
          ReflTm(_) => Ok(Unit)
          J(_, _, _, _, _, _) => Ok(Unit)
        }
      }
      Const(name2) => match call_spine(name, Const(name2), TNil) {
        Some(args) => match has_decreasing_arg(args, decreasing) {
          True => Ok(Unit)
          False => Err(NotDecreasing)
        }
        None => Ok(Unit)
      }
      Var(_) => Ok(Unit)
      Ty(_) => Ok(Unit)
      PropTy => Ok(Unit)
      TNil => Ok(Unit)
      TCons(head, tail) => match check_tm(k, name, depth, decreasing, head) {
        Ok(Unit) => check_tm(k, name, depth, decreasing, tail)
        Err(e) => Err(e)
      }
      Ind(_, args) => check_args(k, name, depth, decreasing, args)
      Ctor(_, _, args) => check_args(k, name, depth, decreasing, args)
      Pi(_, dom, cod) => match check_tm(k, name, depth, decreasing, dom) {
        Ok(Unit) => check_tm(k, name, depth + 1u32, shift_decreasing(decreasing, 1u32), cod)
        Err(e) => Err(e)
      }
      Lam(_, dom, body) => match check_tm(k, name, depth, decreasing, dom) {
        Ok(Unit) => check_tm(k, name, depth + 1u32, shift_decreasing(decreasing, 1u32), body)
        Err(e) => Err(e)
      }
      Match(scrut, branches) => match check_tm(k, name, depth, decreasing, scrut) {
        Ok(Unit) => check_branches(k, name, depth, decreasing, branches)
        Err(e) => Err(e)
      }
      TBrNil => Ok(Unit)
      TBrCons(_, binders, body, rest) => {
        let shifted = shift_decreasing(decreasing, binders)
        let inner = add_fields(16, binders, shifted)
        match check_tm(k, name, depth + binders, inner, body) {
          Ok(Unit) => check_tm(k, name, depth, decreasing, rest)
          Err(e) => Err(e)
        }
      }
      Eq(lhs, rhs) => match check_tm(k, name, depth, decreasing, lhs) {
        Ok(Unit) => check_tm(k, name, depth, decreasing, rhs)
        Err(e) => Err(e)
      }
      ReflTm(value) => check_tm(k, name, depth, decreasing, value)
      J(a, b, c, d, e, f) => match check_tm(k, name, depth, decreasing, a) {
        Ok(Unit) => match check_tm(k, name, depth, decreasing, b) {
          Ok(Unit) => match check_tm(k, name, depth, decreasing, c) {
            Ok(Unit) => match check_tm(k, name, depth, decreasing, d) {
              Ok(Unit) => match check_tm(k, name, depth, decreasing, e) {
                Ok(Unit) => check_tm(k, name, depth, decreasing, f)
                Err(err) => Err(err)
              }
              Err(err) => Err(err)
            }
            Err(err) => Err(err)
          }
          Err(err) => Err(err)
        }
        Err(err) => Err(err)
      }
    }
  }
}

fn check_fn(info: FnInfo): Result[Unit, TerminationError] {
  match info {
    FnData(name, num_params, body) => check_tm(1000, name, num_params, Nil, body)
  }
}

pub fn check_termination(fns: FnList): Result[Unit, TerminationError] {
  match fns {
    FnNil => Ok(Unit)
    FnCons(info, rest) => match check_fn(info) {
      Ok(Unit) => check_termination(rest)
      Err(e) => Err(e)
    }
  }
}

fn good_add_fns(): FnList {
  let zero_branch = TBrCons(0u32, 0u32, Var(1u32), TBrNil)
  let call = App(App(Const("add"), Var(0u32)), Var(1u32))
  let succ_branch = TBrCons(1u32, 1u32, call, zero_branch)
  let body = Match(Var(0u32), succ_branch)
  FnCons(FnData("add", 2u32, body), FnNil)
}

fn bad_loop_fns(): FnList {
  FnCons(
    FnData("loop", 1u32, App(Const("loop"), Var(0u32))),
    FnNil
  )
}

fn bad_succ_fns(): FnList {
  FnCons(
    FnData(
      "loop",
      1u32,
      App(Const("loop"), Ctor("Succ", 1u32, TCons(Var(0u32), TNil)))
    ),
    FnNil
  )
}

pub fn demo_termination_good(): U32 {
  match check_termination(good_add_fns()) {
    Ok(Unit) => 1u32
    Err(_) => 0u32
  }
}

pub fn demo_termination_loop(): U32 {
  match check_termination(bad_loop_fns()) {
    Err(NotDecreasing) => 1u32
    Err(_) => 0u32
    Ok(Unit) => 0u32
  }
}

pub fn demo_termination_succ(): U32 {
  match check_termination(bad_succ_fns()) {
    Err(NotDecreasing) => 1u32
    Err(_) => 0u32
    Ok(Unit) => 0u32
  }
}

pub fn demo_infer_match(): U32 {
  match infer(
    100,
    bool_globals,
    Nil,
    Match(Ctor("Bool", 1u32, TNil), bool_branches())
  ) {
    Ok(VType(level)) => match level == 1u32 {
      True => 1u32
      False => 0u32
    }
    Ok(VNil) => 0u32
    Ok(VCons(_, _)) => 0u32
    Ok(VVar(_)) => 0u32
    Ok(VConst(_)) => 0u32
    Ok(VProp) => 0u32
    Ok(VInd(_, _)) => 0u32
    Ok(VCtor(_, _, _)) => 0u32
    Ok(VPi(_, _, _, _)) => 0u32
    Ok(VLam(_, _, _, _)) => 0u32
    Ok(VApp(_, _)) => 0u32
    Ok(VError(_)) => 0u32
    Err(_) => 0u32
  }
}

pub fn demo_infer_j(): U32 {
  match infer(
    100,
    empty_globals,
    Nil,
    J(
      Ty(0u32),
      Ty(0u32),
      Ty(0u32),
      ReflTm(Ty(0u32)),
      Lam("x", Ty(0u32), Ty(1u32)),
      Ty(0u32)
    )
  ) {
    Ok(VType(level)) => match level == 1u32 {
      True => 1u32
      False => 0u32
    }
    Ok(VNil) => 0u32
    Ok(VCons(_, _)) => 0u32
    Ok(VVar(_)) => 0u32
    Ok(VConst(_)) => 0u32
    Ok(VProp) => 0u32
    Ok(VInd(_, _)) => 0u32
    Ok(VCtor(_, _, _)) => 0u32
    Ok(VPi(_, _, _, _)) => 0u32
    Ok(VLam(_, _, _, _)) => 0u32
    Ok(VApp(_, _)) => 0u32
    Ok(VError(_)) => 0u32
    Err(_) => 0u32
  }
}
