    Ok(Ind(_, _)) => 0u32
    Ok(Ctor(_, _, _)) => 0u32
    Ok(Pi(_, _, _)) => 0u32
    Ok(Lam(_, _, _)) => 0u32
    Ok(App(_, _)) => 0u32
    Ok(Match(_, _)) => 0u32
    Ok(TBrNil) => 0u32
    Ok(TBrCons(_, _, _, _)) => 0u32
    Ok(Eq(_, _)) => 0u32
    Ok(ReflTm(_)) => 0u32
    Ok(J(_, _, _, _, _, _)) => 0u32
    Err(_) => 0u32
  }
}

