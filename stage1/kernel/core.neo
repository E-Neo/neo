fn both(a: Bool, b: Bool): Bool {
  match a {
    True => b
    False => False
  }
}

pub fn conv(fuel: Nat, level: U32, a: Val, b: Val): Result[Bool, KernelError] {
  match fuel {
    Zero => Err(OutOfFuel)
    Succ(k) => match a {
      VNil => match b {
        VNil => Ok(True)
        VCons(_, _) => Ok(False)
        VVar(_) => Ok(False)
        VConst(_) => Ok(False)
        VType(_) => Ok(False)
        VProp => Ok(False)
        VInd(_, _) => Ok(False)
        VCtor(_, _, _) => Ok(False)
        VPi(_, _, _, _) => Ok(False)
        VLam(_, _, _, _) => Ok(False)
        VApp(_, _) => Ok(False)
        VError(e) => Err(e)
      }
      VCons(ah, at) => match b {
        VNil => Ok(False)
        VCons(bh, bt) => match conv(k, level, ah, bh) {
          Ok(True) => conv(k, level, at, bt)
          Ok(False) => Ok(False)
          Err(e) => Err(e)
        }
        VVar(_) => Ok(False)
        VConst(_) => Ok(False)
        VType(_) => Ok(False)
        VProp => Ok(False)
        VInd(_, _) => Ok(False)
        VCtor(_, _, _) => Ok(False)
        VPi(_, _, _, _) => Ok(False)
        VLam(_, _, _, _) => Ok(False)
        VApp(_, _) => Ok(False)
        VError(e) => Err(e)
      }
      VVar(i) => match b {
        VVar(j) => match i == j {
          True => Ok(True)
          False => Ok(False)
        }
        VNil => Ok(False)
        VCons(_, _) => Ok(False)
        VConst(_) => Ok(False)
        VType(_) => Ok(False)
        VProp => Ok(False)
        VInd(_, _) => Ok(False)
        VCtor(_, _, _) => Ok(False)
        VPi(_, _, _, _) => Ok(False)
        VLam(_, _, _, _) => Ok(False)
        VApp(_, _) => Ok(False)
        VError(e) => Err(e)
      }
      VConst(x) => match b {
        VConst(y) => match x == y {
          True => Ok(True)
          False => Ok(False)
        }
        VNil => Ok(False)
        VCons(_, _) => Ok(False)
        VVar(_) => Ok(False)
        VType(_) => Ok(False)
        VProp => Ok(False)
        VInd(_, _) => Ok(False)
        VCtor(_, _, _) => Ok(False)
        VPi(_, _, _, _) => Ok(False)
        VLam(_, _, _, _) => Ok(False)
        VApp(_, _) => Ok(False)
        VError(e) => Err(e)
      }
      VType(x) => match b {
        VType(y) => match x == y {
          True => Ok(True)
          False => Ok(False)
        }
        VNil => Ok(False)
        VCons(_, _) => Ok(False)
        VVar(_) => Ok(False)
        VConst(_) => Ok(False)
        VProp => Ok(False)
        VInd(_, _) => Ok(False)
        VCtor(_, _, _) => Ok(False)
        VPi(_, _, _, _) => Ok(False)
        VLam(_, _, _, _) => Ok(False)
        VApp(_, _) => Ok(False)
        VError(e) => Err(e)
      }
      VProp => match b {
        VProp => Ok(True)
        VNil => Ok(False)
        VCons(_, _) => Ok(False)
        VVar(_) => Ok(False)
        VConst(_) => Ok(False)
        VType(_) => Ok(False)
        VInd(_, _) => Ok(False)
        VCtor(_, _, _) => Ok(False)
        VPi(_, _, _, _) => Ok(False)
        VLam(_, _, _, _) => Ok(False)
        VApp(_, _) => Ok(False)
        VError(e) => Err(e)
      }
      VInd(xn, xa) => match b {
        VInd(yn, ya) => match xn == yn {
          True => conv(k, level, xa, ya)
          False => Ok(False)
        }
        VNil => Ok(False)
        VCons(_, _) => Ok(False)
        VVar(_) => Ok(False)
        VConst(_) => Ok(False)
        VType(_) => Ok(False)
        VProp => Ok(False)
        VCtor(_, _, _) => Ok(False)
        VPi(_, _, _, _) => Ok(False)
        VLam(_, _, _, _) => Ok(False)
        VApp(_, _) => Ok(False)
        VError(e) => Err(e)
      }
      VCtor(xn, xi, xa) => match b {
        VCtor(yn, yi, ya) => match xn == yn {
          True => match xi == yi {
            True => conv(k, level, xa, ya)
            False => Ok(False)
          }
          False => Ok(False)
        }
        VNil => Ok(False)
        VCons(_, _) => Ok(False)
        VVar(_) => Ok(False)
        VConst(_) => Ok(False)
        VType(_) => Ok(False)
        VProp => Ok(False)
        VInd(_, _) => Ok(False)
        VPi(_, _, _, _) => Ok(False)
        VLam(_, _, _, _) => Ok(False)
        VApp(_, _) => Ok(False)
        VError(e) => Err(e)
      }
      VPi(xn, xd, xc, xe) => match b {
        VPi(yn, yd, yc, ye) => match conv(k, level, xd, yd) {
          Ok(True) => match eval(k, env_ext(xe, VVar(level)), xc) {
            Ok(xv) => match eval(k, env_ext(ye, VVar(level)), yc) {
              Ok(yv) => conv(k, level + 1u32, xv, yv)
              Err(e) => Err(e)
            }
            Err(e) => Err(e)
          }
          Ok(False) => Ok(False)
          Err(e) => Err(e)
        }
        VNil => Ok(False)
        VCons(_, _) => Ok(False)
        VVar(_) => Ok(False)
        VConst(_) => Ok(False)
        VType(_) => Ok(False)
        VProp => Ok(False)
        VInd(_, _) => Ok(False)
        VCtor(_, _, _) => Ok(False)
        VLam(_, _, _, _) => Ok(False)
        VApp(_, _) => Ok(False)
        VError(e) => Err(e)
      }
      VLam(xn, xd, xb, xe) => match b {
        VLam(yn, yd, yb, ye) => match conv(k, level, xd, yd) {
          Ok(True) => match eval(k, env_ext(xe, VVar(level)), xb) {
            Ok(xv) => match eval(k, env_ext(ye, VVar(level)), yb) {
              Ok(yv) => conv(k, level + 1u32, xv, yv)
              Err(e) => Err(e)
            }
            Err(e) => Err(e)
          }
          Ok(False) => Ok(False)
          Err(e) => Err(e)
        }
        VNil => Ok(False)
        VCons(_, _) => Ok(False)
        VVar(_) => Ok(False)
        VConst(_) => Ok(False)
        VType(_) => Ok(False)
        VProp => Ok(False)
        VInd(_, _) => Ok(False)
        VCtor(_, _, _) => Ok(False)
        VPi(_, _, _, _) => Ok(False)
        VApp(_, _) => Ok(False)
        VError(e) => Err(e)
      }
      VApp(xf, xa) => match b {
        VApp(yf, ya) => match conv(k, level, xf, yf) {
          Ok(True) => conv(k, level, xa, ya)
          Ok(False) => Ok(False)
          Err(e) => Err(e)
        }
        VNil => Ok(False)
        VCons(_, _) => Ok(False)
        VVar(_) => Ok(False)
        VConst(_) => Ok(False)
        VType(_) => Ok(False)
        VProp => Ok(False)
        VInd(_, _) => Ok(False)
        VCtor(_, _, _) => Ok(False)
        VPi(_, _, _, _) => Ok(False)
        VLam(_, _, _, _) => Ok(False)
        VError(e) => Err(e)
      }
      VError(e) => Err(e)
    }
  }
}

pub fn demo_conv_alpha(): U32 {
  let left = Lam("x", Ty(0u32), Var(0u32))
  let right = Lam("y", Ty(0u32), Var(0u32))
  match eval(100, env_empty, left) {
    Ok(vleft) => match eval(100, env_empty, right) {
      Ok(vright) => match conv(100, 0u32, vleft, vright) {
        Ok(True) => 1u32
        Ok(False) => 0u32
        Err(_) => 0u32
      }
      Err(_) => 0u32
    }
    Err(_) => 0u32
  }
}

pub fn demo_conv_diff(): U32 {
  match eval(100, env_empty, Ty(0u32)) {
    Ok(v0) => match eval(100, env_empty, Ty(1u32)) {
      Ok(v1) => match conv(100, 0u32, v0, v1) {
        Ok(True) => 0u32
        Ok(False) => 1u32
        Err(_) => 0u32
      }
      Err(_) => 0u32
    }
    Err(_) => 0u32
  }
}

pub enum Sort {
  SProp
  SType(U32)
}

pub enum CtorList {
  CNil
  CCons(CtorInfo, CtorList)
}

pub enum CtorInfo {
  CtorData(String, String, U32, U32, U32, Tm)
}

pub enum EnumInfo {
  EnumData(String, U32, Sort, Bool, CtorList)
}

pub fn empty_globals(name: String): Option[EnumInfo] {
  None
}

pub fn ctor_at(ctors: CtorList, index: U32): Option[CtorInfo] {
  match ctors {
    CNil => None
    CCons(info, rest) => match index == 0u32 {
      True => Some(info)
      False => ctor_at(rest, index - 1u32)
    }
  }
}

pub fn apply_val(fuel: Nat, f: Val, arg: Val): Result[Val, KernelError] {
  match fuel {
    Zero => Err(OutOfFuel)
    Succ(k) => match f {
      VLam(_, _, body, env) => eval(k, env_ext(env, arg), body)
      VPi(_, _, cod, env) => eval(k, env_ext(env, arg), cod)
      VError(e) => Err(e)
      VNil => Err(NotFunction)
      VCons(_, _) => Err(NotFunction)
      VVar(_) => Err(NotFunction)
      VConst(_) => Err(NotFunction)
      VType(_) => Err(NotFunction)
      VProp => Err(NotFunction)
      VInd(_, _) => Err(NotFunction)
      VCtor(_, _, _) => Err(NotFunction)
      VApp(_, _) => Err(NotFunction)
    }
  }
}

pub fn apply_type(fuel: Nat, ty: Val, args: Val): Result[Val, KernelError] {
  match fuel {
    Zero => Err(OutOfFuel)
    Succ(k) => match args {
      VNil => Ok(ty)
      VCons(arg, rest) => match ty {
        VPi(_, _, cod, env) => match eval(k, env_ext(env, arg), cod) {
          Ok(next) => apply_type(k, next, rest)
          Err(e) => Err(e)
        }
        VError(e) => Err(e)
        VNil => Err(NotFunction)
        VCons(_, _) => Err(NotFunction)
        VVar(_) => Err(NotFunction)
        VConst(_) => Err(NotFunction)
        VType(_) => Err(NotFunction)
        VProp => Err(NotFunction)
        VInd(_, _) => Err(NotFunction)
        VCtor(_, _, _) => Err(NotFunction)
        VLam(_, _, _, _) => Err(NotFunction)
        VApp(_, _) => Err(NotFunction)
      }
      VError(e) => Err(e)
      VVar(_) => Err(Unsupported)
      VConst(_) => Err(Unsupported)
      VType(_) => Err(Unsupported)
      VProp => Err(Unsupported)
      VInd(_, _) => Err(Unsupported)
      VCtor(_, _, _) => Err(Unsupported)
      VPi(_, _, _, _) => Err(Unsupported)
      VLam(_, _, _, _) => Err(Unsupported)
      VApp(_, _) => Err(Unsupported)
    }
  }
}

pub fn bool_globals(name: String): Option[EnumInfo] {
  match name == "Bool" {
    True => Some(
      EnumData(
        "Bool",
        0u32,
        SType(0u32),
        True,
        CCons(
          CtorData("False", "Bool", 0u32, 0u32, 0u32, Ind("Bool", TNil)),
          CCons(
            CtorData("True", "Bool", 1u32, 0u32, 0u32, Ind("Bool", TNil)),
            CNil
          )
        )
      )
    )
    False => None
  }
}

pub fn ctx_len(ctx: List[Val]): U32 {
  match ctx {
    Nil => 0u32
    Cons(_, rest) => 1u32 + ctx_len(rest)
  }
}

pub fn ctx_env(ctx: List[Val]): fn(U32) -> Val {
  let level = ctx_len(ctx)
  fn(index: U32) => VVar(level - 1u32 - index)
}

pub fn ctx_get(ctx: List[Val], index: U32): Result[Val, KernelError] {
  match ctx {
    Nil => Err(Unbound)
    Cons(ty, rest) => match index == 0u32 {
      True => Ok(ty)
      False => ctx_get(rest, index - 1u32)
    }
  }
}

fn sort_max(a: Sort, b: Sort): Sort {
  match a {
    SProp => match b {
      SProp => SProp
      SType(v) => SType(v)
    }
    SType(u) => match b {
      SProp => SType(u)
      SType(v) => match u >= v {
        True => SType(u)
        False => SType(v)
      }
    }
  }
}

fn sort_value(sort: Sort): Val {
  match sort {
    SProp => VProp
    SType(level) => VType(level)
  }
}

pub enum BranchLookup {
  BSome(U32, Tm)
  BNone
}

pub fn branch_at(branches: Tm, index: U32): BranchLookup {
  match branches {
    TBrNil => BNone
    TBrCons(branch_index, binders, body, rest) => match branch_index == index {
      True => BSome(binders, body)
      False => branch_at(rest, index)
    }
    TNil => BNone
    TCons(_, _) => BNone
    Var(_) => BNone
    Const(_) => BNone
    Ty(_) => BNone
    PropTy => BNone
    Ind(_, _) => BNone
    Ctor(_, _, _) => BNone
    Pi(_, _, _) => BNone
    Lam(_, _, _) => BNone
    App(_, _) => BNone
    Match(_, _) => BNone
    Eq(_, _) => BNone
    ReflTm(_) => BNone
    J(_, _, _, _, _, _) => BNone
  }
}

pub fn env_extend_list(fuel: Nat, env: fn(U32) -> Val, args: Val): fn(U32) -> Val {
  match fuel {
    Zero => env
    Succ(k) => match args {
      VNil => env
      VCons(arg, rest) => env_extend_list(k, env_ext(env, arg), rest)
      VVar(_) => env
      VConst(_) => env
      VType(_) => env
      VProp => env
      VInd(_, _) => env
      VCtor(_, _, _) => env
      VPi(_, _, _, _) => env
      VLam(_, _, _, _) => env
      VApp(_, _) => env
      VError(_) => env
    }
  }
}

pub fn ctor_fields(
  fuel: Nat,
  ty: Val,
  level: U32,
  acc: List[Val]
): Result[List[Val], KernelError] {
  match fuel {
    Zero => Err(OutOfFuel)
    Succ(k) => match ty {
      VPi(_, dom, cod, env) => match eval(k, env_ext(env, VVar(level)), cod) {
        Ok(next) => ctor_fields(k, next, level + 1u32, Cons(dom, acc))
        Err(e) => Err(e)
      }
      VInd(_, _) => Ok(acc.reverse())
      VError(e) => Err(e)
      VNil => Err(Unsupported)
      VCons(_, _) => Err(Unsupported)
      VVar(_) => Err(Unsupported)
      VConst(_) => Err(Unsupported)
      VType(_) => Err(Unsupported)
      VProp => Err(Unsupported)
      VCtor(_, _, _) => Err(Unsupported)
      VLam(_, _, _, _) => Err(Unsupported)
      VApp(_, _) => Err(Unsupported)
    }
  }
}

pub fn constructor_fields(
  fuel: Nat,
  globals: fn(String) -> Option[EnumInfo],
  enum_name: String,
  index: U32,
  params: Val
): Result[List[Val], KernelError] {
  match globals(enum_name) {
    Some(EnumData(_, _, _, _, ctors)) => match ctor_at(ctors, index) {
      Some(CtorData(_, _, _, _, _, ty)) => match eval(fuel, env_empty, ty) {
        Ok(vty) => match apply_type(fuel, vty, params) {
          Ok(fields) => ctor_fields(fuel, fields, 0u32, Nil)
          Err(e) => Err(e)
        }
        Err(e) => Err(e)
      }
      None => Err(UnknownCtor)
    }
    None => Err(UnknownEnum)
  }
}

fn infer_sort(fuel: Nat, value: Val): Result[Sort, KernelError] {
  match fuel {
    Zero => Err(OutOfFuel)
    Succ(k) => match value {
      VProp => Ok(SProp)
      VType(level) => Ok(SType(level))
      VError(e) => Err(e)
      VNil => Err(NotType)
      VCons(_, _) => Err(NotType)
      VVar(_) => Err(NotType)
      VConst(_) => Err(NotType)
      VInd(_, _) => Err(NotType)
      VCtor(_, _, _) => Err(NotType)
      VPi(_, _, _, _) => Err(NotType)
      VLam(_, _, _, _) => Err(NotType)
      VApp(_, _) => Err(NotType)
    }
  }
}

pub fn infer(
  fuel: Nat,
  globals: fn(String) -> Option[EnumInfo],
  ctx: List[Val],
  tm: Tm
): Result[Val, KernelError] {
  match fuel {
    Zero => Err(OutOfFuel)
    Succ(k) => match tm {
      Var(index) => ctx_get(ctx, index)
      Ty(level) => Ok(VType(level + 1u32))
      PropTy => Ok(VType(0u32))
      Pi(name, dom, cod) => match eval(k, ctx_env(ctx), dom) {
        Ok(vdom) => match infer_sort(k, vdom) {
          Ok(sdom) => match eval(k, env_ext(ctx_env(ctx), VVar(ctx_len(ctx))), cod) {
            Ok(vcod) => match infer_sort(k, vcod) {
              Ok(scod) => Ok(sort_value(sort_max(sdom, scod)))
              Err(e) => Err(e)
            }
            Err(e) => Err(e)
          }
          Err(e) => Err(e)
        }
        Err(e) => Err(e)
      }
      Lam(name, dom, body) => match eval(k, ctx_env(ctx), dom) {
        Ok(vdom) => match infer_sort(k, vdom) {
          Ok(_) => match infer(k, globals, Cons(vdom, ctx), body) {
            Ok(body_ty) => match quote(k, ctx_len(ctx) + 1u32, body_ty) {
              Ok(cod) => Ok(VPi(name, vdom, cod, ctx_env(ctx)))
              Err(e) => Err(e)
            }
            Err(e) => Err(e)
          }
          Err(e) => Err(e)
        }
        Err(e) => Err(e)
      }
      App(f, a) => match infer(k, globals, ctx, f) {
        Ok(VPi(_, dom, cod, env)) => match check(k, globals, ctx, a, dom) {
          Ok(Unit) => match eval(k, ctx_env(ctx), a) {
            Ok(value) => eval(k, env_ext(env, value), cod)
            Err(e) => Err(e)
          }
          Err(e) => Err(e)
        }
        Ok(VError(e)) => Err(e)
        Ok(_) => Err(NotFunction)
        Err(e) => Err(e)
      }
      Eq(lhs, rhs) => match infer(k, globals, ctx, lhs) {
        Ok(ty) => match check(k, globals, ctx, rhs, ty) {
          Ok(Unit) => Ok(VProp)
          Err(e) => Err(e)
        }
        Err(e) => Err(e)
      }
      ReflTm(_) => Err(Unsupported)
      J(_, lhs, rhs, proof, motive, _) => match eval(k, ctx_env(ctx), lhs) {
        Ok(vlhs) => match eval(k, ctx_env(ctx), rhs) {
          Ok(vrhs) => match check(
            k,
            globals,
            ctx,
            proof,
            VInd("Eq", VCons(vlhs, VCons(vrhs, VNil)))
          ) {
            Ok(Unit) => match eval(k, ctx_env(ctx), motive) {
              Ok(vmotive) => apply_val(k, vmotive, vrhs)
              Err(e) => Err(e)
            }
            Err(e) => Err(e)
          }
          Err(e) => Err(e)
        }
        Err(e) => Err(e)
      }
      Const(_) => Err(Unsupported)
      TNil => Err(Unsupported)
      TCons(_, _) => Err(Unsupported)
      Ind(name, args) => match globals(name) {
        Some(EnumData(_, _, sort, _, _)) => match eval(k, ctx_env(ctx), args) {
          Ok(_) => Ok(sort_value(sort))
          Err(e) => Err(e)
        }
        None => Err(UnknownEnum)
      }
      Ctor(name, index, args) => match globals(name) {
        Some(EnumData(_, _, _, _, ctors)) => match ctor_at(ctors, index) {
          Some(CtorData(_, _, _, _, _, ty)) => match eval(k, env_empty, ty) {
            Ok(vty) => match eval(k, ctx_env(ctx), args) {
              Ok(vargs) => apply_type(k, vty, vargs)
              Err(e) => Err(e)
            }
            Err(e) => Err(e)
          }
          None => Err(UnknownCtor)
        }
        None => Err(UnknownEnum)
      }
      Match(scrut, branches) => infer_match(k, globals, ctx, scrut, branches)
      TBrNil => Err(Unsupported)
      TBrCons(_, _, _, _) => Err(Unsupported)
    }
  }
}

pub fn check(
  fuel: Nat,
  globals: fn(String) -> Option[EnumInfo],
  ctx: List[Val],
  tm: Tm,
  expected: Val
): Result[Unit, KernelError] {
  match fuel {
    Zero => Err(OutOfFuel)
    Succ(k) => match tm {
      Lam(name, dom, body) => match expected {
        VPi(_, pdom, cod, env) => match eval(k, ctx_env(ctx), dom) {
          Ok(vdom) => match conv(k, ctx_len(ctx), vdom, pdom) {
            Ok(True) => match eval(k, env_ext(env, VVar(ctx_len(ctx))), cod) {
              Ok(codv) => check(k, globals, Cons(pdom, ctx), body, codv)
              Err(e) => Err(e)
            }
            Ok(False) => Err(TypeMismatch)
            Err(e) => Err(e)
          }
          Err(e) => Err(e)
        }
        VError(e) => Err(e)
        VNil => Err(NotFunction)
        VCons(_, _) => Err(NotFunction)
        VVar(_) => Err(NotFunction)
        VConst(_) => Err(NotFunction)
        VType(_) => Err(NotFunction)
        VProp => Err(NotFunction)
        VInd(_, _) => Err(NotFunction)
        VCtor(_, _, _) => Err(NotFunction)
        VLam(_, _, _, _) => Err(NotFunction)
        VApp(_, _) => Err(NotFunction)
      }
      ReflTm(value) => match expected {
        VInd(name, VCons(lhs, VCons(rhs, VNil))) => match name == "Eq" {
          True => match eval(k, ctx_env(ctx), value) {
            Ok(v) => match conv(k, ctx_len(ctx), v, lhs) {
              Ok(True) => match conv(k, ctx_len(ctx), lhs, rhs) {
                Ok(True) => Ok(Unit)
                Ok(False) => Err(TypeMismatch)
                Err(e) => Err(e)
              }
              Ok(False) => Err(TypeMismatch)
              Err(e) => Err(e)
            }
            Err(e) => Err(e)
          }
          False => Err(TypeMismatch)
        }
        VInd(_, _) => Err(TypeMismatch)
        VNil => Err(TypeMismatch)
        VCons(_, _) => Err(TypeMismatch)
        VVar(_) => Err(TypeMismatch)
        VConst(_) => Err(TypeMismatch)
        VType(_) => Err(TypeMismatch)
        VProp => Err(TypeMismatch)
        VCtor(_, _, _) => Err(TypeMismatch)
        VPi(_, _, _, _) => Err(TypeMismatch)
        VLam(_, _, _, _) => Err(TypeMismatch)
        VApp(_, _) => Err(TypeMismatch)
        VError(e) => Err(e)
      }
      J(_, lhs, rhs, proof, motive, refl_case) => match eval(k, ctx_env(ctx), lhs) {
        Ok(vlhs) => match eval(k, ctx_env(ctx), rhs) {
          Ok(vrhs) => match check(
            k,
            globals,
            ctx,
            proof,
            VInd("Eq", VCons(vlhs, VCons(vrhs, VNil)))
          ) {
            Ok(Unit) => match eval(k, ctx_env(ctx), motive) {
              Ok(vmotive) => match apply_val(k, vmotive, vlhs) {
                Ok(lhs_ty) => match apply_val(k, vmotive, vrhs) {
                  Ok(rhs_ty) => match conv(k, ctx_len(ctx), rhs_ty, expected) {
                    Ok(True) => check(k, globals, ctx, refl_case, lhs_ty)
                    Ok(False) => Err(TypeMismatch)
                    Err(e) => Err(e)
                  }
                  Err(e) => Err(e)
                }
                Err(e) => Err(e)
              }
              Err(e) => Err(e)
            }
            Err(e) => Err(e)
          }
          Err(e) => Err(e)
        }
        Err(e) => Err(e)
      }
      Var(_) => check_infer(k, globals, ctx, tm, expected)
      Ty(_) => check_infer(k, globals, ctx, tm, expected)
      PropTy => check_infer(k, globals, ctx, tm, expected)
      Pi(_, _, _) => check_infer(k, globals, ctx, tm, expected)
      App(_, _) => check_infer(k, globals, ctx, tm, expected)
      Eq(_, _) => check_infer(k, globals, ctx, tm, expected)
      Const(_) => check_infer(k, globals, ctx, tm, expected)
      TNil => check_infer(k, globals, ctx, tm, expected)
      TCons(_, _) => check_infer(k, globals, ctx, tm, expected)
      Ind(_, _) => check_infer(k, globals, ctx, tm, expected)
      Ctor(_, _, _) => check_infer(k, globals, ctx, tm, expected)
      Match(scrut, branches) => check_match(k, globals, ctx, scrut, branches, expected)
      TBrNil => check_infer(k, globals, ctx, tm, expected)
      TBrCons(_, _, _, _) => check_infer(k, globals, ctx, tm, expected)
    }
  }
}

pub enum InferState {
  InferNone
  InferSome(Val)
}

fn infer_match(
  fuel: Nat,
  globals: fn(String) -> Option[EnumInfo],
  ctx: List[Val],
  scrut: Tm,
  branches: Tm
): Result[Val, KernelError] {
  match infer(fuel, globals, ctx, scrut) {
    Ok(VInd(enum_name, params)) => match globals(enum_name) {
      Some(EnumData(_, _, _, _, ctors)) => infer_ctors(
        fuel,
        globals,
        ctx,
        enum_name,
        params,
        ctors,
        branches,
        InferNone
      )
      None => Err(UnknownEnum)
    }
    Ok(VError(e)) => Err(e)
    Ok(VNil) => Err(Unsupported)
    Ok(VCons(_, _)) => Err(Unsupported)
    Ok(VVar(_)) => Err(Unsupported)
    Ok(VConst(_)) => Err(Unsupported)
    Ok(VType(_)) => Err(Unsupported)
    Ok(VProp) => Err(Unsupported)
    Ok(VCtor(_, _, _)) => Err(Unsupported)
    Ok(VPi(_, _, _, _)) => Err(Unsupported)
    Ok(VLam(_, _, _, _)) => Err(Unsupported)
    Ok(VApp(_, _)) => Err(Unsupported)
    Err(e) => Err(e)
  }
}

fn infer_ctors(
  fuel: Nat,
  globals: fn(String) -> Option[EnumInfo],
  ctx: List[Val],
  enum_name: String,
  params: Val,
  ctors: CtorList,
  branches: Tm,
  state: InferState
): Result[Val, KernelError] {
  match fuel {
    Zero => Err(OutOfFuel)
    Succ(k) => match ctors {
      CNil => match state {
        InferNone => Err(Unsupported)
        InferSome(ty) => Ok(ty)
      }
      CCons(CtorData(_, _, index, _, num_fields, _), rest) => match branch_at(branches, index) {
        BSome(binders, body) => match binders == num_fields {
          True => match constructor_fields(k, globals, enum_name, index, params) {
            Ok(fields) => match state {
              InferNone => match infer(k, globals, fields.reverse().append(ctx), body) {
                Ok(ty) => infer_ctors(
                  k,
                  globals,
                  ctx,
                  enum_name,
                  params,
                  rest,
                  branches,
                  InferSome(ty)
                )
                Err(e) => Err(e)
              }
              InferSome(ty) => match check(
                k,
                globals,
                fields.reverse().append(ctx),
                body,
                ty
              ) {
                Ok(Unit) => infer_ctors(
                  k,
                  globals,
                  ctx,
                  enum_name,
                  params,
                  rest,
                  branches,
                  InferSome(ty)
                )
                Err(e) => Err(e)
              }
            }
            Err(e) => Err(e)
          }
          False => Err(BadBranch)
        }
        BNone => Err(NotExhaustive)
      }
    }
  }
}

fn check_match(
  fuel: Nat,
  globals: fn(String) -> Option[EnumInfo],
  ctx: List[Val],
  scrut: Tm,
  branches: Tm,
  expected: Val
): Result[Unit, KernelError] {
  match infer(fuel, globals, ctx, scrut) {
    Ok(VInd(enum_name, params)) => match globals(enum_name) {
      Some(EnumData(_, _, _, _, ctors)) => check_ctors(
        fuel,
        globals,
        ctx,
        expected,
        enum_name,
        params,
        ctors,
        branches
      )
      None => Err(UnknownEnum)
    }
    Ok(VError(e)) => Err(e)
    Ok(VNil) => Err(Unsupported)
    Ok(VCons(_, _)) => Err(Unsupported)
    Ok(VVar(_)) => Err(Unsupported)
    Ok(VConst(_)) => Err(Unsupported)
    Ok(VType(_)) => Err(Unsupported)
    Ok(VProp) => Err(Unsupported)
    Ok(VCtor(_, _, _)) => Err(Unsupported)
    Ok(VPi(_, _, _, _)) => Err(Unsupported)
    Ok(VLam(_, _, _, _)) => Err(Unsupported)
    Ok(VApp(_, _)) => Err(Unsupported)
    Err(e) => Err(e)
  }
}

fn check_ctors(
  fuel: Nat,
  globals: fn(String) -> Option[EnumInfo],
  ctx: List[Val],
  expected: Val,
  enum_name: String,
  params: Val,
  ctors: CtorList,
  branches: Tm
): Result[Unit, KernelError] {
  match fuel {
    Zero => Err(OutOfFuel)
    Succ(k) => match ctors {
      CNil => Ok(Unit)
      CCons(CtorData(_, _, index, _, num_fields, _), rest) => match branch_at(branches, index) {
        BSome(binders, body) => match binders == num_fields {
          True => match constructor_fields(k, globals, enum_name, index, params) {
            Ok(fields) => match check(k, globals, fields.reverse().append(ctx), body, expected) {
              Ok(Unit) => check_ctors(
                k,
                globals,
                ctx,
                expected,
                enum_name,
                params,
                rest,
                branches
              )
              Err(e) => Err(e)
            }
            Err(e) => Err(e)
          }
          False => Err(BadBranch)
        }
        BNone => Err(NotExhaustive)
      }
    }
  }
}

fn check_infer(
  fuel: Nat,
  globals: fn(String) -> Option[EnumInfo],
  ctx: List[Val],
  tm: Tm,
  expected: Val
): Result[Unit, KernelError] {
  match infer(fuel, globals, ctx, tm) {
    Ok(found) => match conv(fuel, ctx_len(ctx), found, expected) {
      Ok(True) => Ok(Unit)
      Ok(False) => Err(TypeMismatch)
      Err(e) => Err(e)
    }
    Err(e) => Err(e)
  }
}

fn identity_pi(): Val {
  VPi("x", VType(0u32), Ty(0u32), env_empty)
}

pub fn demo_check_identity(): U32 {
  match check(100, empty_globals, Nil, Lam("x", Ty(0u32), Var(0u32)), identity_pi()) {
    Ok(Unit) => 1u32
    Err(_) => 0u32
  }
}

pub fn demo_check_bad(): U32 {
  match check(100, empty_globals, Nil, Lam("x", Ty(0u32), Ty(0u32)), identity_pi()) {
    Ok(Unit) => 0u32
    Err(TypeMismatch) => 1u32
    Err(_) => 0u32
  }
}

pub fn demo_infer_pi(): U32 {
  match infer(100, empty_globals, Nil, Pi("x", Ty(0u32), Ty(0u32))) {
    Ok(VType(_)) => 1u32
    Ok(VNil) => 0u32
    Ok(VCons(_, _)) => 0u32
    Ok(VVar(_)) => 0u32
    Ok(VConst(_)) => 0u32
    Ok(VProp) => 0u32
    Ok(VInd(_, _)) => 0u32
    Ok(VCtor(_, _, _)) => 0u32
    Ok(VPi(_, _, _, _)) => 0u32
    Ok(VLam(_, _, _, _)) => 0u32
    Ok(VApp(_, _)) => 0u32
    Ok(VError(_)) => 0u32
    Err(_) => 0u32
  }
}

pub fn demo_infer_app(): U32 {
  let term = App(Lam("x", Ty(1u32), Var(0u32)), Ty(0u32))
  match infer(100, empty_globals, Nil, term) {
    Ok(VType(level)) => match level == 1u32 {
      True => 1u32
      False => 0u32
    }
    Ok(VNil) => 0u32
    Ok(VCons(_, _)) => 0u32
    Ok(VVar(_)) => 0u32
    Ok(VConst(_)) => 0u32
    Ok(VProp) => 0u32
    Ok(VInd(_, _)) => 0u32
    Ok(VCtor(_, _, _)) => 0u32
    Ok(VPi(_, _, _, _)) => 0u32
    Ok(VLam(_, _, _, _)) => 0u32
    Ok(VApp(_, _)) => 0u32
    Ok(VError(_)) => 0u32
    Err(_) => 0u32
  }
}

pub fn demo_infer_ind_bool(): U32 {
  match infer(100, bool_globals, Nil, Ind("Bool", TNil)) {
    Ok(VType(level)) => match level == 0u32 {
      True => 1u32
      False => 0u32
    }
    Ok(VNil) => 0u32
    Ok(VCons(_, _)) => 0u32
    Ok(VVar(_)) => 0u32
    Ok(VConst(_)) => 0u32
    Ok(VProp) => 0u32
    Ok(VInd(_, _)) => 0u32
    Ok(VCtor(_, _, _)) => 0u32
    Ok(VPi(_, _, _, _)) => 0u32
    Ok(VLam(_, _, _, _)) => 0u32
    Ok(VApp(_, _)) => 0u32
    Ok(VError(_)) => 0u32
    Err(_) => 0u32
  }
}

pub fn demo_infer_ctor_bool(): U32 {
