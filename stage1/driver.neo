mod frontend;
mod codegen;

fn after_write(value: U32, r: Result[Unit, IoError]): IO[Result[U32, IoError]] {
  match r {
    Ok(_) => IO::pure(Ok(value))
    Err(e) => IO::pure(Err(e))
  }
}

fn after_read(output: String, r: Result[Bytes, IoError]): IO[Result[U32, IoError]] {
  match r {
    Ok(bytes) => match frontend::parser::compile_program(1000, bytes) {
      Ok(insn) => IO::bind(
        file::write(output, codegen::wasm::module_from_instructions(insn)),
        fn(done: Result[Unit, IoError]) => after_write(0u32, done)
      )
      Err(_) => IO::pure(Err(InvalidInput))
    }
    Err(e) => IO::pure(Err(e))
  }
}

fn after_args(args: List[String]): IO[Result[U32, IoError]] {
  match args {
    Cons(source, rest) => match rest {
      Cons(output, _) => IO::bind(
        file::read(source),
        fn(r: Result[Bytes, IoError]) => after_read(output, r)
      )
      Nil => IO::pure(Err(InvalidInput))
      Cons(_, _) => IO::pure(Err(InvalidInput))
    }
    Nil => IO::pure(Err(InvalidInput))
  }
}

fn main(): IO[Result[U32, IoError]] {
  IO::bind(env::args(), after_args)
}
